# Copy this file to .env and fill in real values. NEVER commit .env.
# .env is loaded server-side only (server/index.js via --env-file). It is never
# sent to the browser and nothing under public/ may reference these values.

NODE_ENV=development

PORT=4000

# ── MySQL (persistent AOS datastore) ──────────────────────────────────────
# Same physical server/schema for laptop dev and the eventual company server -
# only these values differ between environments. NEVER commit real values.
DB_HOST=192.168.27.157
DB_PORT=3306
DB_NAME=production_tracker
DB_USER=
DB_PASSWORD=
# "true" only if the MySQL server requires/accepts TLS.
DB_SSL=false
DB_CONNECTION_LIMIT=10

# ── MySQL pool tuning (database review remediation, 2026-09-04) ───────────
# All optional - every one of these has a sane built-in default (see
# server/config.js for the exact reasoning behind each) and setting nothing
# changes nothing about current behavior. Only worth overriding per
# environment if you have a specific reason to (e.g. a busier production
# deployment wanting a larger DB_MAX_IDLE_CONNECTIONS to avoid reopening
# connections during a traffic lull).
#
# Max connections mysql2 keeps open+idle for reuse (rather than closing
# outright once DB_IDLE_TIMEOUT_MS elapses). Must be LESS than
# DB_CONNECTION_LIMIT for mysql2 to actually enforce DB_IDLE_TIMEOUT_MS at
# all (confirmed by reading its pool.js: the idle-reaper job only starts
# when maxIdle < connectionLimit) - defaults to half of DB_CONNECTION_LIMIT
# (floor 2), not the full limit.
# DB_MAX_IDLE_CONNECTIONS=5
# How long an idle pooled connection may sit unused before mysql2 closes it.
# DB_IDLE_TIMEOUT_MS=60000
# Time budget to establish a brand-new TCP+auth connection to MySQL.
# DB_CONNECT_TIMEOUT_MS=10000
# Time budget to obtain a connection FROM THE POOL (covers waiting for one
# to free up when every connection is busy) - the actual fix for "must not
# hang indefinitely" when the pool is exhausted; mysql2 has no native
# timeout for this wait.
# DB_ACQUIRE_TIMEOUT_MS=10000
# Per-statement timeout, applied to every query this app runs.
# DB_QUERY_TIMEOUT_MS=30000
# Idle time before TCP keep-alive probes start on a pooled connection (finds a dropped Wi-Fi socket fast).
# DB_KEEPALIVE_MS=10000
# Ping interval that keeps the pool warm and replaces dead connections (0 = off).
# DB_WARM_PING_MS=30000
# Extra attempts for a read that fails on a dropped connection (writes are never retried). 0 = off.
# DB_READ_RETRIES=2

# Database used by the automated test suite. Must be a SEPARATE schema from
# DB_NAME - the test suite refuses to run otherwise (see server/test setup).
# Leave unset until production_tracker_test (or equivalent) has been created
# and confirmed to exist.
TEST_DB_NAME=production_tracker_test

# Session cookie lifetime, in hours.
SESSION_TTL_HOURS=8

# Set to "true" only when served over HTTPS (adds the Secure cookie flag).
COOKIE_SECURE=false

# ── Google Apps Script (legacy Tote Purge / Tote Utilisation data source) ──
# Same deployed web app + Script Key the Chrome extension already uses.
# Holding this here (server-side env var) is exactly what the Phase 0 plan
# calls for: the backend calls Apps Script with the Script Key; the browser
# never sees it.
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec
APPS_SCRIPT_KEY=

# Optional: abort the Apps Script call if it hasn't responded within this many
# milliseconds. Surfaces as query status TIMEOUT rather than hanging forever.
APPS_SCRIPT_TIMEOUT_MS=30000
# Needed when the Apps Script web app is restricted to your Workspace domain
# (Google answers with a sign-in page otherwise). Path to a Google
# "authorized_user" credentials JSON for a domain account, e.g. made with:
#   gcloud auth application-default login --scopes=openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/drive.readonly
# (it prints the file path). Leave blank if the web app is publicly reachable.
APPS_SCRIPT_AUTH_CREDENTIALS_PATH=

# ── Dev-only seed users (see server/platform/db/migrate.js) ──
# Only used the FIRST time the database is created, and ONLY when
# NODE_ENV is not "production" - seeding never runs automatically against a
# production database. Change these passwords immediately in any
# shared/real environment; this is a Phase 1 proof-of-architecture
# convenience, not a real user-management system.
SEED_ADMIN_ID=ADMIN001
SEED_ADMIN_PASSWORD=ChangeMe-Admin-1!
SEED_USER_ID=EMP001
SEED_USER_PASSWORD=ChangeMe-User-1!

# ── Capability dispatch efficiency (2026-09-04) ────────────────────────────
# Optional - every capability request still works with this unset. See
# server/integrations/capabilities/requestCoalescer.js for the actual mechanics. Applies
# only to READ-ONLY capabilities (everything except PULL_QUADRON_TOTE, which
# always executes fresh, every time).
#
# How long a completed read-only capability's result is served to a
# brand-new request for the same capability+params with zero upstream
# requests, before it's considered stale. 0 disables the cache entirely.
CAPABILITY_RESULT_CACHE_TTL_MS=3000

# ── Grafana / Concinity (Quadron) / NexS origins ────────────────────────────
# Same physical host for Grafana and Quadron today (reverse-proxied under
# /grafana/ and /concinity/ respectively) - kept as separate variables so
# either can be repointed independently later.
GRAFANA_ORIGIN=https://192.168.24.230
QUADRON_ORIGIN=https://192.168.24.230
QUADRON_INSTANCE_CODE=LK-069
NEXS_ORIGIN=https://app.nexs.lenskart.com

# ── Service logins ─────────────────────────────────────────────────────────
# Every capability runs server-side: the backend logs into Grafana, Concinity
# (Quadron) and NexS itself using the shared accounts below (see
# server/integrations/logins/). There is no browser extension / runtime relay.
#
# Shared single-login accounts (2026-09-22, operator-requested: "single
# login point... all logged in together") - ONE service account per system.
# NexS mirrors the Monitor Panel Revamped project's own login (same account,
# operator-confirmed - NexS only allows one active session per account, so
# this collides with Monitor Panel Revamped's own session until a second,
# dedicated NexS account exists; the backend therefore only logs into NexS
# on demand). All six are required - a missing value fails loudly.
GRAFANA_DIRECT_USERNAME=
GRAFANA_DIRECT_PASSWORD=
CONCINITY_DIRECT_USERNAME=
CONCINITY_DIRECT_PASSWORD=
NEXS_DIRECT_USERNAME=
NEXS_DIRECT_PASSWORD=

# ── One Pager Report -> Slack (2026-09-07) ──────────────────────────────────
# Incoming Webhook URL for the one Slack channel the One Pager Report posts
# to (Slack workspace -> Apps -> Incoming Webhooks -> Add to Slack -> pick a
# channel). Looks like https://hooks.slack.com/services/T000/B000/XXXXXXXX.
# Required before the "Send to Slack" button works - unset, it fails loudly
# rather than silently doing nothing.
SLACK_ONE_PAGER_REPORT_WEBHOOK_URL=

# ── One Pager Report -> Google Sheet (2026-09-08) ───────────────────────────
# Written via the Sheets API + a service account (NOT an Apps Script Web
# App - the Lenskart Workspace has no true "Anyone" access option for
# those, so an unauthenticated call always redirects to a Google sign-in
# page). See server/apps-script/SETUP.md for how to create the service
# account, download its JSON key, and share the Sheet with it. Both
# required before "Save to Sheet" works.
#
# The Spreadsheet ID is the long id in the Sheet's own URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
ONE_PAGER_REPORT_SHEET_SPREADSHEET_ID=
# Local file path to the downloaded service account JSON key. Keep this
# file OUTSIDE the repo (or gitignored) - it is a real credential.
ONE_PAGER_REPORT_SHEET_SERVICE_ACCOUNT_KEY_PATH=

