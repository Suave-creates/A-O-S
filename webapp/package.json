{
  "name": "aos-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "ASRS Intelligence & Automation | AOS - live ASRS monitoring, tote operations and reporting",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --env-file=.env server/index.js",
    "start:local-dev": "node --env-file=.env --env-file=.env.local-dev server/index.js",
    "migrate": "node --env-file=.env server/platform/db/runMigrate.js",
    "sync-local-to-company": "node --env-file=.env server/scripts/syncToCompany.js",
    "dev:mock-apps-script": "node server/dev/mockAppsScript.js",
    "test": "node --env-file-if-exists=.env --test \"server/test/**/*.test.js\""
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.2",
    "html2canvas": "^1.4.1",
    "mysql2": "^3.23.4"
  }
}
